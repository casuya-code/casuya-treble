POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-local-postgres-password
POSTGRES_DB=casuyawin
POSTGRES_PASSWORD_ENCODED=url-encoded-password

DATABASE_URL=postgresql+asyncpg://postgres:url-encoded-password@localhost:5432/casuyawin
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
PURGE_DAYS=90

# BetPawa Tanzania fixture import (defaults work for betpawa.co.tz)
BETPAWA_BASE_URL=https://www.betpawa.co.tz
BETPAWA_BRAND=betpawa-tanzania
BETPAWA_FETCH_TAKE=60

# Optional — https://the-odds-api.com/ (free tier 500 req/month)
ODDS_API_KEY=
ODDS_DEFAULT_SPORT=soccer_epl
ODDS_DEFAULT_REGION=uk

# Local admin — created on API startup if the email does not exist yet
ADMIN_EMAIL=admin@casuyawin.com
ADMIN_PASSWORD=CasuyaAdmin#2026

JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRE_HOURS=72
APP_PUBLIC_URL=http://localhost:3000
EXPOSE_PASSWORD_RESET_LINK=true
